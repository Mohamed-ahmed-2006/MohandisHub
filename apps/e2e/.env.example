# Copy to apps/e2e/.env.local for staging/sandbox money E2E.
# Never put production payment credentials here.

# Web app URL used by the browser tests.
PLAYWRIGHT_BASE_URL=https://staging.example.com

# API URL used for direct setup/assertion calls.
E2E_API_BASE_URL=https://api-staging.example.com

# Seeded staging users. Create these in the staging app/admin panel.
E2E_CUSTOMER_EMAIL=customer-e2e@example.com
E2E_CUSTOMER_PASSWORD=replace-me
E2E_PROVIDER_EMAIL=provider-e2e@example.com
E2E_PROVIDER_PASSWORD=replace-me
E2E_ADMIN_EMAIL=admin-e2e@example.com
E2E_ADMIN_PASSWORD=replace-me

# This admin should have manage_transactions only.
E2E_SCOPED_ADMIN_EMAIL=money-admin-e2e@example.com
E2E_SCOPED_ADMIN_PASSWORD=replace-me

# NOWPayments sandbox/test currency for checkout creation.
E2E_SANDBOX_PAY_CURRENCY=USDTTRC20

# Optional paid-reservation fixture.
# Use an active paid service and a future available slot belonging to E2E_PAID_PROVIDER_ID.
E2E_PAID_PROVIDER_ID=00000000-0000-0000-0000-000000000000
E2E_PAID_SERVICE_ID=00000000-0000-0000-0000-000000000000
E2E_PAID_SLOT_ID=00000000-0000-0000-0000-000000000000
E2E_PAID_RESERVATION_MODE=online
E2E_PAID_RESERVATION_ONLINE_TYPE=voice
