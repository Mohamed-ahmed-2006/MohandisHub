{
  "name": "@mohandishub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @mohandishub/shared",
    "dev": "node ../../scripts/kill-port.js && tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "migrate:expert-verification": "tsx scripts/run-expert-verification-migration.ts"
  },
  "dependencies": {
    "@mohandishub/shared": "file:../../packages/shared",
    "@sentry/node": "^8.40.0",
    "@supabase/supabase-js": "^2.47.0",
    "@types/web-push": "^3.6.4",
    "agora-access-token": "^2.0.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.13.3",
    "resend": "^6.17.1",
    "socket.io": "^4.8.1",
    "stripe": "^20.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "vitest": "^4.1.8"
  }
}
