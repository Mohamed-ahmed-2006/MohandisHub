# Local: development. Hosted HTTPS API: must be production (or omit NODE_ENV so the host sets it).
# If you set NODE_ENV=development on Render/Vercel-style hosts, refresh cookies stay SameSite=Lax and
# cross-origin login/refresh breaks (401 NO_REFRESH_TOKEN). Fix: production, or AUTH_CROSS_SITE_REFRESH_COOKIE=1.
NODE_ENV=development
# AUTH_CROSS_SITE_REFRESH_COOKIE=0
PORT=4000
# PostgreSQL connection. For Supabase: Project Settings → Database.
# If you get "getaddrinfo ENOTFOUND ...pooler.supabase.com", use the DIRECT connection URI instead of the pooler:
#   Direct: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#   Pooler: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Also ensure your Supabase project is not paused (free tier projects pause after inactivity).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres
# Tune for your database plan. Defaults: DB_POOL_MAX=10, DB_IDLE_TIMEOUT_MS=30000.
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
CORS_ORIGIN=http://localhost:3000
# Public web app base URL used in password reset emails
WEB_PUBLIC_URL=http://localhost:3000
# Production with www and non-www: use comma-separated (no spaces) in a single variable:
# CORS_ORIGIN=https://mohandishub.app,https://www.mohandishub.app
# Or use CORS_EXTRA_ORIGINS:
# CORS_ORIGIN=https://mohandishub.app
# CORS_EXTRA_ORIGINS=https://www.mohandishub.app

# Production behind Render/nginx (one hop): real client IP for rate limiting. Omit on local dev unless you proxy.
# TRUST_PROXY=1
# Optional rate-limit overrides (per IP): API_* = all /api routes; AUTH_* = /api/auth and /api/otp only.
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW_MS=600000

# Auth / JWT — generate strong random secrets (min 32 chars)
# Production rejects copied placeholder values and rejects using the same value for both secrets.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-secret-at-least-32
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Verification provider: 'didit' or 'manual' for production. 'idenfy' is not launch-ready.
VERIFICATION_PROVIDER=didit
# IDENFY_API_KEY=
# IDENFY_API_SECRET=

# Didit KYC — get from https://business.didit.me
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
# DIDIT_BASE_URL=https://verification.didit.me/v3

# OTP delivery - 'console' for dev (no real email), 'resend' for production email via Resend.
# Production blocks console/sendgrid email. SMS supports twilio, http_adapter, or meta_whatsapp when configured.
OTP_EMAIL_PROVIDER=console
OTP_SMS_PROVIDER=console
# Resend (password reset & OTP emails): set OTP_EMAIL_PROVIDER=resend and:
# - RESEND_API_KEY: from the Resend dashboard
# - EMAIL_FROM: verified sender, for example "MohandisHub <otp@mail.mohandishub.app>"
# - EMAIL_LOGO_URL: optional absolute logo URL for transactional emails
RESEND_API_KEY=
# EMAIL_FROM="MohandisHub <otp@mail.mohandishub.app>"
# EMAIL_LOGO_URL=https://mohandishub.app/brand/mohandishub-email-logo.png
# Legacy optional provider:
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SMS_HTTP_ENDPOINT=
# SMS_HTTP_API_KEY=
# SMS_HTTP_FROM=MohandisHub
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_OTP_TEMPLATE=mohandishub_otp
# META_WHATSAPP_LANGUAGE=en_US

# Web Push (PWA browser push). Required only when WEB_PUSH_ENABLED=true.
WEB_PUSH_ENABLED=false
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@mohandishub.app

# Backup/restore provider API. Keep disabled until production backup credentials are configured.
# BACKUP_PROVIDER=disabled
# Supabase adapter:
# BACKUP_PROVIDER=supabase
# BACKUP_SUPABASE_PROJECT_REF=
# BACKUP_SUPABASE_ACCESS_TOKEN=
# BACKUP_SUPABASE_BASE_URL=https://api.supabase.com
# Custom HTTP adapter:
# BACKUP_PROVIDER=custom_http
# BACKUP_CUSTOM_BASE_URL=https://backup-ops.example.com
# BACKUP_CUSTOM_API_KEY=
# BACKUP_CUSTOM_STATUS_PATH=/status
# BACKUP_CUSTOM_LIST_PATH=/backups
# BACKUP_CUSTOM_DRY_RUN_PATH=/restores/dry-run
# BACKUP_CUSTOM_RESTORE_PATH=/restores

# Cryptomus — crypto payments (wallet deposit). Get from https://doc.cryptomus.com/
# Merchant ID: Settings → Merchant → copy UUID
# API key: Settings → API keys → Payment API key (for creating invoices)
# Webhook key: same as API key or from webhook settings (used to verify webhook sign)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
# CRYPTOMUS_WEBHOOK_KEY=

# Stripe — card payments (wallet deposit). Required for card deposit; set on production (e.g. Render).
# Get keys from https://dashboard.stripe.com/apikeys (use test keys for sandbox)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from Stripe Dashboard → Webhooks, or from `stripe listen` for local)
# STRIPE_PUBLISHABLE_KEY=pk_test_... (optional, for client-side if needed)

# Public URL of this API in production. Required when NODE_ENV=production.
# API_PUBLIC_URL=https://api.mohandishub.app

# NOWPayments (wallet deposits + freelancer withdrawals)
# API key from Merchant Store settings. Prefix "api:" is accepted and stripped automatically.
# NOWPAYMENTS_API_KEY=api:...
# IPN secret from Store settings (used to verify x-nowpayments-sig)
# NOWPAYMENTS_IPN_SECRET=
# Dashboard/Webhook URL (single field): https://api.mohandishub.app/api/wallet/nowpayments/ipn
# Email/password are required only for Mass Payout auth/verify endpoints.
# NOWPAYMENTS_AUTH_EMAIL=
# NOWPAYMENTS_AUTH_PASSWORD=
# Feature flags
# Production defaults to NOT requiring NOWPayments at startup. Set true only after
# NOWPayments keys are configured and crypto/card deposits should be live.
# NOWPAYMENTS_LIVE_REQUIRED=false
# NOWPAYMENTS_FIAT_ENABLED=false
# NOWPAYMENTS_CUSTODY_ENABLED=false
# NOWPAYMENTS_MASS_PAYOUTS_ENABLED=false
# NOWPAYMENTS_WITHDRAWALS_ENABLED=false
# NOWPAYMENTS_MANUAL_PAYOUT_VERIFY=true
# NOWPAYMENTS_WITHDRAWAL_MIN_AMOUNT=20
# NOWPAYMENTS_WITHDRAWAL_DEFAULT_CURRENCY=USDTTRC20
# Optional comma-separated allowlist (e.g. "USDTTRC20,BTC,ETH")
# NOWPAYMENTS_ALLOWED_PAY_CURRENCIES=

# Paymob (EGP-native card/wallet deposits + payouts). Deposits/withdrawals stay
# disabled and return PAYMOB_NOT_CONFIGURED until these are set + the flags on.
# Secret + public keys from Paymob Dashboard → Settings → API Keys.
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# HMAC secret (Dashboard → Settings → Account info) — verifies deposit callbacks.
# PAYMOB_HMAC_SECRET=
# Comma-separated integration ids enabled on the unified checkout (e.g. "1234,5678").
# PAYMOB_INTEGRATION_IDS=
# PAYMOB_API_BASE_URL=https://accept.paymob.com
# PAYMOB_DEPOSITS_ENABLED=false
# Payout / disbursement (separate Paymob product credentials).
# PAYMOB_WITHDRAWALS_ENABLED=false
# PAYMOB_PAYOUT_CLIENT_ID=
# PAYMOB_PAYOUT_CLIENT_SECRET=
# Production payout URL from Paymob. Do not use staging URLs in production.
# PAYMOB_PAYOUT_BASE_URL=

# Agora RTC (online reservations)
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=

# Supabase Storage — required in production (NODE_ENV=production). Without it, public uploads
# (logos, avatars) and private uploads use local disk and are deleted on every deploy (e.g. Render).
# Get from Supabase Dashboard → Project Settings → API: Project URL and service_role key.
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Sentry. Required in production so API and worker failures are visible. Disable in dev by omitting.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ---------------------------------------------------------------------------
# Data retention (optional). Retention worker runs in-process on an interval.
# 0 = never delete / skip that entity. Only applied when DATABASE_URL is set.
# ---------------------------------------------------------------------------
# RETENTION_SWEEP_INTERVAL_MS=900000
# RETENTION_VERIFICATION_CODES_AFTER_EXPIRY_HOURS=24
# RETENTION_OTP_RATE_LIMIT_WINDOW_HOURS=24
# RETENTION_REFRESH_TOKENS_AFTER_EXPIRY_DAYS=7
# RETENTION_VERIFICATION_REQUESTS_DAYS=90
# RETENTION_CHAT_MESSAGES_DAYS=0
# RETENTION_UPLOADS_DAYS=0
# Optional: strip completed-need reference media + bid message attachments (0 = off).
# RETENTION_NEED_REFERENCE_DAYS_AFTER_COMPLETED=0
# RETENTION_BID_MESSAGE_ATTACHMENT_DAYS=0
# Optional: strip old terminal KYC document files from private uploads after legal retention (0 = off).
# RETENTION_VERIFIED_PRIVATE_UPLOADS_DAYS=0
# Hard ceiling for max public upload bytes from admin settings (multer uses this cap).
# PUBLIC_UPLOAD_MAX_BYTES_CEILING=15728640
