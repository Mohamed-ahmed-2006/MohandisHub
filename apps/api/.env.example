NODE_ENV=development
PORT=4000
# PostgreSQL connection. For Supabase: Project Settings → Database.
# If you get "getaddrinfo ENOTFOUND ...pooler.supabase.com", use the DIRECT connection URI instead of the pooler:
#   Direct: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#   Pooler: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Also ensure your Supabase project is not paused (free tier projects pause after inactivity).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres
CORS_ORIGIN=http://localhost:3000
# Public web app base URL used in password reset emails
WEB_PUBLIC_URL=http://localhost:3000
# Production with www and non-www: use comma-separated (no spaces) in a single variable:
# CORS_ORIGIN=https://mohandishub.app,https://www.mohandishub.app
# Or use CORS_EXTRA_ORIGINS:
# CORS_ORIGIN=https://mohandishub.app
# CORS_EXTRA_ORIGINS=https://www.mohandishub.app

# Auth / JWT — generate strong random secrets (min 32 chars)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-secret-at-least-32
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Verification provider: 'didit', 'manual', or 'idenfy'
VERIFICATION_PROVIDER=didit
# IDENFY_API_KEY=
# IDENFY_API_SECRET=

# Didit KYC — get from https://business.didit.me
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
# DIDIT_BASE_URL=https://verification.didit.me/v3

# OTP delivery — 'console' for dev (no real email), 'brevo' for real email via Brevo
OTP_EMAIL_PROVIDER=console
OTP_SMS_PROVIDER=console
# Brevo (password reset & OTP emails): set OTP_EMAIL_PROVIDER=brevo and:
# - BREVO_API_KEY: from https://app.brevo.com/settings/keys/api (SMTP & API key)
# - EMAIL_FROM: sender address (must be verified in Brevo: Senders & IP → Senders)
# - EMAIL_LOGO_URL: optional absolute logo URL for transactional emails
BREVO_API_KEY=
# EMAIL_FROM=noreply@mohandishub.app
# EMAIL_LOGO_URL=https://mohandishub.app/brand/mohandishub-email-logo.png
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Cryptomus — crypto payments (wallet deposit). Get from https://doc.cryptomus.com/
# Merchant ID: Settings → Merchant → copy UUID
# API key: Settings → API keys → Payment API key (for creating invoices)
# Webhook key: same as API key or from webhook settings (used to verify webhook sign)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
# CRYPTOMUS_WEBHOOK_KEY=

# Stripe — card payments (wallet deposit). Required for card deposit; set on production (e.g. Render).
# Get keys from https://dashboard.stripe.com/apikeys (use test keys for sandbox)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from Stripe Dashboard → Webhooks, or from `stripe listen` for local)
# STRIPE_PUBLISHABLE_KEY=pk_test_... (optional, for client-side if needed)

# Optional: public URL of this API (for Cryptomus callback). Defaults to CORS_ORIGIN if unset.
# API_PUBLIC_URL=https://api.yourdomain.com

# NOWPayments (wallet deposits + freelancer withdrawals)
# API key from Merchant Store settings. Prefix "api:" is accepted and stripped automatically.
# NOWPAYMENTS_API_KEY=api:...
# IPN secret from Store settings (used to verify x-nowpayments-sig)
# NOWPAYMENTS_IPN_SECRET=
# Dashboard/Webhook URL (single field): https://api.yourdomain.com/api/wallet/nowpayments/ipn
# Email/password are required only for Mass Payout auth/verify endpoints.
# NOWPAYMENTS_AUTH_EMAIL=
# NOWPAYMENTS_AUTH_PASSWORD=
# Feature flags
# NOWPAYMENTS_FIAT_ENABLED=false
# NOWPAYMENTS_CUSTODY_ENABLED=false
# NOWPAYMENTS_MASS_PAYOUTS_ENABLED=false
# NOWPAYMENTS_WITHDRAWALS_ENABLED=false
# NOWPAYMENTS_MANUAL_PAYOUT_VERIFY=true
# NOWPAYMENTS_WITHDRAWAL_MIN_AMOUNT=20
# NOWPAYMENTS_WITHDRAWAL_DEFAULT_CURRENCY=USDTTRC20
# Optional comma-separated allowlist (e.g. "USDTTRC20,BTC,ETH")
# NOWPAYMENTS_ALLOWED_PAY_CURRENCIES=

# Agora RTC (online reservations)
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=

# ---------------------------------------------------------------------------
# Data retention (optional). Retention worker runs in-process on an interval.
# 0 = never delete / skip that entity. Only applied when DATABASE_URL is set.
# ---------------------------------------------------------------------------
# RETENTION_SWEEP_INTERVAL_MS=900000
# RETENTION_VERIFICATION_CODES_AFTER_EXPIRY_HOURS=24
# RETENTION_OTP_RATE_LIMIT_WINDOW_HOURS=24
# RETENTION_REFRESH_TOKENS_AFTER_EXPIRY_DAYS=7
# RETENTION_VERIFICATION_REQUESTS_DAYS=90
# RETENTION_CHAT_MESSAGES_DAYS=0
# RETENTION_UPLOADS_DAYS=0
