{
  "name": "@mohandishub/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @mohandishub/shared",
    "dev": "next dev -p 3000",
    "build": "next build --no-lint",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app components lib tests next.config.ts tailwind.config.ts vitest.config.ts --max-warnings=0",
    "test": "vitest --run"
  },
  "dependencies": {
    "@mohandishub/shared": "file:../../packages/shared",
    "@vercel/speed-insights": "^1.3.1",
    "agora-rtc-sdk-ng": "^4.24.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.0.8"
  }
}
