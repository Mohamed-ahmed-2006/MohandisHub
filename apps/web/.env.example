# Production launch:
# - Web domain: https://mohandishub.app
# - API domain: https://api.mohandishub.app
# - Paymob stays hidden until account activation, env keys, and admin rail enablement are ready.

# Leave empty to use Next.js rewrites. If the API is on a separate public domain,
# set this to that HTTPS base URL without a trailing slash.
# Production: NEXT_PUBLIC_API_URL=https://api.mohandishub.app
NEXT_PUBLIC_API_URL=

# Local dev with a remote API can use same-origin rewrites so refresh cookies work.
# NEXT_PUBLIC_AUTH_SAME_ORIGIN=1

# Internal URL for Next.js rewrites (server-side only).
# Production: API_INTERNAL_URL=https://api.mohandishub.app
API_INTERNAL_URL=http://localhost:4000

# Agora RTC public app id (for client SDK initialization).
NEXT_PUBLIC_AGORA_APP_ID=

# Keep false until NOWPayments fiat/card is enabled on the account.
NEXT_PUBLIC_NOWPAYMENTS_FIAT_ENABLED=false

# Paymob is hidden by default until configured and enabled by admin settings.
NEXT_PUBLIC_PAYMOB_ENABLED=false
