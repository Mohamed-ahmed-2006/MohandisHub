# Leave empty to use Next.js rewrites (recommended — avoids CORS).
# Only set this if the API is hosted on a separate public domain.
NEXT_PUBLIC_API_URL=

# Internal URL for Next.js rewrites (server-side only).
# Defaults to http://localhost:4000 if not set.
API_INTERNAL_URL=http://localhost:4000

# Agora RTC public app id (for client SDK initialization)
NEXT_PUBLIC_AGORA_APP_ID=

# Enable card/fiat option in deposit modal (kept false until NOWPayments fiat is enabled on account)
NEXT_PUBLIC_NOWPAYMENTS_FIAT_ENABLED=false
